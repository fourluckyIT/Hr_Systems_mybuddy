# ─── Production .env template — xHR Payroll v1.3.0 ────────────────────
# Copy to .env on the server, fill in the blanks, then:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache && php artisan route:cache && php artisan view:cache

APP_NAME="xHR Payroll"
APP_ENV=production
APP_KEY=                                # `php artisan key:generate` fills this in
APP_DEBUG=false
APP_TIMEZONE=Asia/Bangkok
APP_URL=https://CHANGE_ME.example.com   # MUST be https://… for production

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logging ─────────────────────────────────────────────────────────
# Keep DEBUG OFF in production. Errors go to storage/logs/laravel.log.
LOG_CHANNEL=daily                       # rotate daily so logs don't fill the disk
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                       # `debug` is noisy — use warning+ in prod

# ─── Database (REQUIRED) ─────────────────────────────────────────────
# SQLite is fine for staging but locks the whole DB on writes. Use MySQL 8
# or Postgres 14+ for any environment with > 1 concurrent writer.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xhr_payroll
DB_USERNAME=xhr
DB_PASSWORD=                            # set on server

# ─── Session ─────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480                    # 8 hours — fits a workday
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true              # https-only cookie
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ─── Cache & queue ───────────────────────────────────────────────────
# No queued jobs / scheduled tasks today, but keep `database` so future
# notification work doesn't need a redis dep.
BROADCAST_CONNECTION=log
CACHE_STORE=database
CACHE_PREFIX=xhr
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# ─── Mail (notifications) ────────────────────────────────────────────
# Set MAIL_MAILER=smtp + credentials below when notification emails are
# wanted. Leave as `log` to silently write to laravel.log for now.
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Misc ────────────────────────────────────────────────────────────
# LibreOffice — required ONLY if any Document Template is uploaded as .docx.
# Renderer auto-detects soffice in PATH or these common locations:
#   /usr/bin/libreoffice  /opt/homebrew/bin/soffice  /usr/local/bin/soffice
# If LibreOffice isn't installed, .docx templates won't render — the system
# falls back to the built-in HTML PDF, so it's safe to skip.

VITE_APP_NAME="${APP_NAME}"
